      {
        "line": 36,
        "text": "## 启动命令"
      },
      {
        "line": 37,
        "text": ""
      },
      {
        "line": 38,
        "text": "须按本机 GPU 与 NUMA 亲和性设置 `--numa-node`。"
      },
      {
        "line": 39,
        "text": ""
      },
      {
        "line": 40,
        "text": "### Qwen3.8-27B IFB BW1100 2x SGLang 0.5.18"
      },
      {
        "line": 41,
        "text": ""
      },
      {
        "line": 42,
        "text": "```bash"
      },
      {
        "line": 43,
        "text": "export SGLANG_ENABLE_SPEC_V2=1"
      },
      {
        "line": 44,
        "text": "export SGLANG_USE_FUSED_TOPK_SOFTMAX=1"
      },
      {
        "line": 45,
        "text": "export SGLANG_USE_LIGHTOP=1"
      },
      {
        "line": 46,
        "text": "export SGLANG_USE_CAUSAL_CONV1D=1"
      },
      {
        "line": 47,
        "text": "export SGLANG_USE_AITER_LINEAR_ATTN=1"
      },
      {
        "line": 48,
        "text": ""
      },
      {
        "line": 49,
        "text": "sglang serve \\"
      },
      {
        "line": 50,
        "text": "  --model-path Qwen/Qwen3.8-27B \\"
      },
      {
        "line": 51,
        "text": "  --attention-backend fa3 \\"
      },
      {
        "line": 52,
        "text": "  --mm-attention-backend fa3 \\"
      },
      {
        "line": 53,
        "text": "  --speculative-algorithm NEXTN \\"
      },
      {
        "line": 54,
        "text": "  --speculative-num-steps 3 \\"
      },
      {
        "line": 55,
        "text": "  --speculative-eagle-topk 1 \\"
      },
      {
        "line": 56,
        "text": "  --speculative-num-draft-tokens 4 \\"
      },
      {
        "line": 57,
        "text": "  --tp-size 2 \\"
      },
      {
        "line": 58,
        "text": "  --pp-size 1 \\"
      },
      {
        "line": 59,
        "text": "  --page-size 64 \\"
      },
      {
        "line": 60,
        "text": "  --mamba-scheduler-strategy extra_buffer \\"
      },
      {
        "line": 61,
        "text": "  --kv-cache-dtype fp8_e4m3 \\"
      },
      {
        "line": 62,
        "text": "  --tool-call-parser qwen3_coder \\"
      },
      {
        "line": 63,
        "text": "  --reasoning-parser qwen3 \\"
      },
      {
        "line": 64,
        "text": "  --trust-remote-code"
      },
      {
        "line": 65,
        "text": "```"
      },
      {
        "line": 66,
        "text": ""
      },
      {
        "line": 67,
        "text": "### Qwen3.8-27B IFB BW1000 2x SGLang 0.5.18"
