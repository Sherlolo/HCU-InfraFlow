      {
        "line": 68,
        "text": ""
      },
      {
        "line": 69,
        "text": "```bash"
      },
      {
        "line": 70,
        "text": "export SGLANG_ENABLE_SPEC_V2=1"
      },
      {
        "line": 71,
        "text": "export SGLANG_USE_FUSED_TOPK_SOFTMAX=1"
      },
      {
        "line": 72,
        "text": "export SGLANG_USE_LIGHTOP=1"
      },
      {
        "line": 73,
        "text": "export SGLANG_USE_CAUSAL_CONV1D=1"
      },
      {
        "line": 74,
        "text": "export SGLANG_USE_AITER_LINEAR_ATTN=1"
      },
      {
        "line": 75,
        "text": ""
      },
      {
        "line": 76,
        "text": "sglang serve \\"
      },
      {
        "line": 77,
        "text": "  --model-path Qwen/Qwen3.8-27B \\"
      },
      {
        "line": 78,
        "text": "  --mem-fraction-static 0.80 \\"
      },
      {
        "line": 79,
        "text": "  --max-running-requests 8 \\"
      },
